<configuration>
    <input>
        <net-file value="straight.net.xml"/>
        <route-files value="straight.rou.xml"/>
    </input>
    <time>
        <begin value="0"/>
        <end value="50"/>
        <step-length value="0.1"/>
    </time>
    <report>
        <no-step-log value="true"/>
        <verbose value="false"/>
    </report>
</configuration>
