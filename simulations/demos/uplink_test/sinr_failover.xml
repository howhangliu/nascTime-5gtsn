<?xml version="1.0" encoding="utf-8"?>
<!--
    Controlled AoI experiment for [Config UplinkSinrFailoverAoI].

    0..1s: both radio legs are healthy; traffic uses UE 0.
    1..2s: UE 0 alone receives a 12dB uplink SINR penalty.
    2..3s: the penalty stays on UE 0, but the route moves to healthy UE 1.
-->
<scenario>
    <at t="1s">
        <set-param module="gnb.cellularNic.channelModel[0]"
                   par="sinrOffset" value="12dB"/>
    </at>
    <at t="2s">
        <set-route module="routeSwitcher" host="tsnDeviceB"
                   destination="tsnDeviceA" gateway="ue[1]%eth0"/>
    </at>
</scenario>
